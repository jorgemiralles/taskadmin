# Copy to .env and adjust as needed (server reads these from the environment)

# Local development Postgres
DATABASE_URL=postgres://taskadmin:taskadmin@my-postgres-2:5432/taskadmin

# Production (Render.com managed Postgres): Render injects DATABASE_URL from the
# linked database defined in render.yaml — no need to set it here.
# Example: postgresql://USER:PASSWORD@dpg-XXXX-a.frankfurt-postgres.render.com/taskadmindb_2i4k

PORT=8080
